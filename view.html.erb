<%-
  # generate form id, based on host and port 
  form_id_1 = Digest::SHA1.hexdigest("--" + host.to_s + "--" + port.to_s + "--" + "1")
-%>
<div style="display: flex; flex-direction: column; gap: 12pt;">

<form id="<%= form_id_1 %>" method="get" action="/pun/sys/dashboard/noVNC-1.3.0/vnc.html" target="<%= form_id_1 %>"  >
  <input type="hidden" name="autoconnect" id="autoconnect" value="true" autocomplete="off">
  <input type="hidden" name="username" value='<%= username %>' />
  <input type="hidden" name="password" />
  <input type="hidden" name="path" value='rnode/<%= host %>/<%= port %>/websockify' />
  <input type="hidden" name="resize" id="resize" value="remote" autocomplete="off">

 <div class="row">
    <div class="col-sm-6">
        <div class="form-group"><label for="compression">Compression</label><input class="form-control custom-range" type="range" min="0" max="9" value="5" name="compression" id="compression"><small class="form-text text-muted">0 (low) to 9 (high)</small></div>
    </div>
    <div class="col-sm-6">
        <div class="form-group"><label for="quality">Image Quality</label><input class="form-control custom-range" type="range" min="0" max="9" value="6" name="quality" id="quality"><small class="form-text text-muted">0 (low) to 9 (high)</small></div>
    </div>
 </div>
  <button class="btn btn-primary" type="button" onclick="getWayNoVNCConnectionParams('<%= form_id_1 %>'); return true;">
    <i class="fa fa-eye"></i> Connect via web client
  </button>
</form>
</div>

<script>
async function openSock(url) {
  const ws = new WebSocket(url);
  return new Promise((resolve, reject) => {
    ws.addEventListener('open',  () => resolve(ws));
    ws.addEventListener('error',  err => reject(ws));
  });
}  

async function getWayNoVNCConnectionParams(form_id) {
  let form = document.getElementById(form_id);
  // Get size of user window
  // Get minitoken and use as password
  form.elements["password"].value = await fetch('/minitoken/exchange', {method: 'GET'}).then(r => r.text());
  // wait for websockify to be ready
  let success = 0;
  while (success === 0) {
      try {
        err = await openSock('/rnode/<%= host %>/<%= port %>/websockify');
        success = 1;
      } catch {
        success = 0;
      }
  }
  // Submit form to open tab with remote desktop
  form.submit();
  }
</script>
