<%-
  # generate form id, based on host and port
  form_id = Digest::SHA1.hexdigest("--" + host.to_s + "--" + port.to_s + "--")
-%>

<form id="<%= form_id %>" method="post" target="_blank" onsubmit="getConnectionFile(<% host %>, <% port %>)">
  <button class="btn btn-primary" type="submit">
    <i class="fa fa-eye"></i> Connect via desktop client
  </button>
</form>

<script>
function getConnectionFile(host, port) {
  let [token, connectfile] = await Promise.all([fetch('/minitoken', {method: 'GET', headers: {'realm': 'vera'}}).then(r => r.text),
                                                fetch('/rdpgw/connect?hostname=${host}&port=${port}', {method: 'GET'}).then(r => r.text)])
  connectfile = connectfile + '\npassword:s:' + token
  let blob = new Blob([connectfile], {type: 'text/plain'});
  let url = window.URL.createObjectURL(blob);
  let link = document.createElement('bloblink');
  link.href = url;
  link.download = 'connect.rdp';
  document.body.appendChild(link);
  link.click();
  document.body.removeChild(link);
  window.URL.revokeObjectURL(url);
}
</script>
