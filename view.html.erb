<%-
  # generate form id, based on host and port
  form_id = Digest::SHA1.hexdigest("--" + host.to_s + "--" + port.to_s + "--")
-%>

  <form id="<%= form_id %>" method="get" target="_blank" onSubmit="getConnectionFile('<%= host %>', '<%= port %>'); return false;" >
  <button class="btn btn-primary" type="submit">
    <i class="fa fa-eye"></i> Connect via desktop client
  </button>
</form>

<script>
function saveObjectToFile (rawObject, filenameWithExtension) {
  object = new Blob([rawObject], {type: 'application/x-rdp'});
  console.log('saveObjectToFile: object', object, 'filenameWithExtension', filenameWithExtension);
  const url = window.URL.createObjectURL(object);
  const link = document.createElement('a');
  link.style.display = 'none';
  link.href = url;
  link.target = '_blank';
  link.download = filenameWithExtension;
  document.body.appendChild(link);
  link.click();
  window.setTimeout(function () {
    document.body.removeChild(link);
    window.URL.revokeObjectURL(url);
  }, 0)
}
async function getConnectionFile(host, port) {
  // Get minitoken + gateway file, append token as password.  
  let [token, connectfile] = await Promise.all([fetch('/minitoken/exchange', {method: 'GET'}).then(r => r.text()),
                                                fetch('/rdpgw/connect?host=' + host + ':' + port, {method: 'GET'}).then(r => r.text())]);
  connectfile = connectfile + 'password:s:' + token + '\n';
  console.log('This is connectfile: ' + connectfile);
  // Deliver file to user
  saveObjectToFile(connectfile, 'connectfile.rdp')
}
</script>
